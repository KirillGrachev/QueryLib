# Конфигурация Lombok для всего проекта.
#
# addLombokGeneratedAnnotation: Lombok помечает сгенерированные методы (геттеры,
# конструкторы, equals/hashCode/toString) аннотацией @lombok.Generated, а JaCoCo
# исключает её из отчёта покрытия. Без этого «покрытие» размывалось бойлерплейтом,
# который никто не должен тестировать вручную, и порог в pom приходилось бы
# занижать, теряя смысл защитного гейта.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
